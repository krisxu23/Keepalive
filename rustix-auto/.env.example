# ===== 账号配置 =====
# 通过环境变量传入账号（推荐用于 CI/Actions）
# 简单格式：邮箱:密码，多个账号用英文逗号分隔
# 注意：密码不能包含英文逗号；密码可以包含冒号（按第一个冒号分割）
# 示例（单账号）：
#   ACCOUNTS=a@example.com:pwd1
# 示例（多账号）：
#   ACCOUNTS=a@example.com:pwd1,b@example.com:pwd2
RUSTIX_ACCOUNTS=

# ===== Telegram 通知配置（可选，留空则不推送）=====
# TG_BOT_TOKEN: 从 @BotFather 获取的 Bot Token
# TG_CHAT_ID:   接收通知的 chat id（从 @userinfobot 获取；群组 id 为负数）
# 示例：
#   TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
#   TG_CHAT_ID=987654321 或 -123456789
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===== 代理节点配置（可选，绕过机房 IP 拦截）=====
# 在 GitHub Actions 中只需配置仓库 Secret NODE_LINK（你的节点链接，支持
# vmess:// trojan:// ss:// vless:// 等格式，或订阅链接），workflow 会自动在
# runner 上启动 sing-box 并把浏览器流量转到节点出口 IP。
# 以下两个变量由 setup_proxy.sh 自动写入 GITHUB_ENV，一般无需手动设置；
# 仅在本地调试时可能需要：
#   IS_PROXY=true
#   PROXY_SERVER=socks5://127.0.0.1:1080   # 或 http://127.0.0.1:1081
IS_PROXY=
PROXY_SERVER=
